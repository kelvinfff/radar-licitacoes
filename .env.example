# Copie para .env e ajuste. O .env nunca vai para o repositório.
DATABASE_URL=postgresql://radar:radar@127.0.0.1:5433/radar

# Recorte da coleta
PNCP_UF=PE
PNCP_DATA_INICIO=2026-01-01

# Ritmo da coleta (a API do PNCP é pública: seja gentil)
# PNCP_INTERVALO_MINIMO_S=5   # abaixo disso a API começa a responder 429
# PNCP_JANELA_DIAS=7
# PNCP_MAX_TENTATIVAS=5
# PNCP_TIMEOUT_S=60

# Testes de integração
# TEST_DATABASE_URL=postgresql://radar:radar@127.0.0.1:5433/radar_test

# LOG_LEVEL=INFO
